{
	"schemaVersion": 1,
	"id": "sharedwaypoints",
	"version": "${version}",
	"name": "SharedWaypoints",
	"description": "Shared waypoints for your server: browse them in chat, add them to Xaero's Minimap in one click, navigate with a live compass and see them on web maps. Only the server needs it; players can add the optional sharedwaypoints-client mod for a waypoint menu and Xaero's Minimap sync.",
	"authors": [
		"steelaspect"
	],
	"contact": {
		"homepage": "https://github.com/SteelAspect/sharedwaypoints",
		"sources": "https://github.com/SteelAspect/sharedwaypoints",
		"issues": "https://github.com/SteelAspect/sharedwaypoints/issues"
	},
	"license": "MIT",
	"icon": "assets/sharedwaypoints/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.steelaspect.sharedwaypoints.SharedWaypoints"
		],
		"client": [
			"io.github.steelaspect.sharedwaypoints.client.SharedWaypointsClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"luckperms": "*",
		"bluemap": "*",
		"squaremap": "*"
	}
}
