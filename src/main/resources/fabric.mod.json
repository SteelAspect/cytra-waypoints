{
	"schemaVersion": 1,
	"id": "sharedwaypoints",
	"version": "${version}",
	"name": "SharedWaypoints",
	"description": "Server-side shared waypoints: browse them in chat, add them to Xaero's Minimap in one click, and navigate with a live compass. Players don't need to install anything.",
	"authors": [
		"SteelAspect"
	],
	"contact": {
		"homepage": "https://github.com/SteelAspect/sharedwaypoints",
		"sources": "https://github.com/SteelAspect/sharedwaypoints",
		"issues": "https://github.com/SteelAspect/sharedwaypoints/issues"
	},
	"license": "MIT",
	"icon": "assets/sharedwaypoints/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.steelaspect.sharedwaypoints.SharedWaypoints"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"luckperms": "*",
		"bluemap": "*",
		"squaremap": "*"
	}
}
